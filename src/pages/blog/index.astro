---
import { seoData } from "../../data/seo-data";
import { site } from "../../data/site.mjs";
import { ui } from "../../data/site-copy";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BlogPostCard from "../../components/astro/BlogPostCard.astro";
import { tagInfo, type ValidTag } from "../../data/tag-data";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const readingTime = (post: (typeof posts)[number]) => "readingTime" in post.data && typeof post.data.readingTime === "number" ? post.data.readingTime : Math.max(1, Math.ceil((post.body ?? "").split(/\s+/).length / 200));
const [latest, ...olderPosts] = posts;
const recentPosts = olderPosts.slice(0, 3);
const usedTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort() as ValidTag[];
---

<Layout title={seoData.blog.title} description={seoData.blog.description} canonical="/blog/" keywords={seoData.blog.keywords}>
  <div class="container-custom py-12 md:py-16">
    <header class="mb-10 md:mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Blog</h1>
      <p class="text-lg text-text-secondary">{site.blogIntro}</p>
      <a href="/blog/rss.xml" class="inline-block mt-4 text-brand-link hover:underline">{ui.rss}</a>
    </header>

    {latest && <BlogPostCard {...latest.data} readingTime={readingTime(latest)} variant="featured" />}

    {recentPosts.length > 0 && (
      <section class="mt-16" aria-labelledby="recent-heading">
        <h2 id="recent-heading" class="text-2xl font-semibold text-white mb-8">{ui.recent}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {recentPosts.map((post) => <BlogPostCard {...post.data} readingTime={readingTime(post)} heading="h3" sizes="(min-width: 768px) 33vw, 100vw" />)}
        </div>
      </section>
    )}

    <section class="mt-16" aria-labelledby="archive-heading">
      <div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
        <h2 id="archive-heading" class="text-2xl font-semibold text-white">{ui.allArticles}</h2>
        <p class="text-sm text-text-secondary" id="post-count" role="status">{posts.length} {posts.length === 1 ? ui.article : ui.articles}</p>
      </div>
      <div class="flex flex-wrap gap-2 mb-8" id="tag-filter" hidden role="group" aria-label={ui.filterTopics}>
        <button class="tag-filter-btn" data-tag="all" aria-pressed="true" aria-controls="posts-grid">{ui.allTopics}</button>
        {usedTags.map((tag) => (
          <button class="tag-filter-btn" data-tag={tag} aria-pressed="false" aria-controls="posts-grid">
            {tagInfo[tag]?.displayName ?? tag}
          </button>
        ))}
      </div>
      <noscript>
        <nav aria-label={ui.filterTopics} class="flex flex-wrap gap-3 mb-8">
          {usedTags.map(tag => <a href={`/blog/tags/${tag}/`} class="text-brand-link hover:underline">{tagInfo[tag].displayName}</a>)}
        </nav>
      </noscript>
      <a href="/blog/tags/" class="inline-block mb-6 text-sm text-text-secondary hover:underline">{ui.allTopicPages} →</a>
      <div id="posts-grid">
        {posts.map((post) => <BlogPostCard {...post.data} readingTime={readingTime(post)} variant="row" heading="h3" />)}
      </div>
      <p class="hidden py-12 text-text-secondary" id="no-posts">{ui.noArticles}</p>
    </section>
  </div>
</Layout>

<style>
  .tag-filter-btn { border: 1px solid rgb(255 255 255 / .16); border-radius: 999px; padding: .5rem .875rem; font-size: .8125rem; color: #a1a1aa; cursor: pointer; }
  .tag-filter-btn:hover { color: #fafafa; background: #242424; }
  .tag-filter-btn[aria-pressed="true"] { background: #fef3c7; color: #121212; border-color: #fef3c7; }
</style>

<script>
  import { ui } from "../../data/site-copy";
  function setupTagFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
    const grid = document.getElementById('posts-grid');
    const count = document.getElementById('post-count');
    const empty = document.getElementById('no-posts');
    if (!grid || !count || !empty) return;
    document.getElementById("tag-filter")?.removeAttribute("hidden");
    const cards = grid.querySelectorAll<HTMLElement>('[data-tags]');
    buttons.forEach((button) => {
      button.onclick = () => {
        const tag = button.dataset.tag;
        buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
        let visibleCount = 0;
        cards.forEach((card) => {
          const show = tag === 'all' || (card.dataset.tags?.split(',') ?? []).includes(tag ?? '');
          card.style.display = show ? '' : 'none';
          if (show) visibleCount++;
        });
        count.textContent = `${visibleCount} ${visibleCount === 1 ? ui.article : ui.articles}`;
        empty.classList.toggle('hidden', visibleCount > 0);
      };
    });
  }
  setupTagFilter();
  document.addEventListener('astro:page-load', setupTagFilter);
</script>
