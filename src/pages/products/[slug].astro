---
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/astro/SectionHeading.astro";
import Testimonial from "../../components/astro/Testimonial.astro";
import CourseOffer from "../../components/astro/CourseOffer.astro";
import Faq from "../../components/astro/Faq.astro";
import LeadCaptureForm from "../../components/ui/LeadCaptureForm";
import { productData, type Product } from "../../data/product-data";
import { getProductTestimonials } from "../../data/testimonial-data";
import { courseFaq } from "../../data/faq-data";
import { seoData, courseSchema } from "../../data/seo-data";
import { site } from "../../data/site.mjs";
import { courseCopy as copy } from "../../data/site-copy";
export async function getStaticPaths() {
  return productData.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}
interface Props {
  product: Product;
}
const { product } = Astro.props;
const seoInfo =
  product.id === site.trackId ? seoData.otelTrack : seoData.otelSpecialization;
const testimonials = getProductTestimonials(product.id, 3);
---

<Layout
  title={seoInfo.title}
  description={seoInfo.description}
  keywords={seoInfo.keywords}
  canonical={`/products/${product.slug}/`}
  jsonLd={courseSchema(product)}
>
  <header class="container-custom pt-10 md:pt-16 pb-12">
    <a
      href="/products/"
      class="inline-block mb-8 text-brand-link hover:underline"
    >
      ← {copy.back}
    </a>
    <div class="max-w-4xl">
      <h1 class="text-3xl md:text-5xl font-bold mb-6">{product.title}</h1>
      <p class="text-lg md:text-xl text-white/80 mb-8 max-w-3xl">
        {product.fullDescription}
      </p>
      <CourseOffer product={product} />
    </div>
  </header>
  {!product.available && (
    <section id="waitlist" class="section-padding">
      <div class="container-custom max-w-xl">
        <h2 class="text-2xl font-bold mb-4">{copy.waitlist}</h2>
        <p class="text-white/80 mb-6">
          {copy.waitlistIntro.replace("{product}", product.title)}
        </p>
        <LeadCaptureForm
          productId={product.id}
          productName={product.title}
          client:visible
        />
      </div>
    </section>
  )}
  <section class="section-padding bg-bg-surface">
    <div class="container-custom">
      <SectionHeading title={copy.features} subtitle={copy.featuresIntro} />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {product.detailedFeatures.map((feature) => (
          <div class="p-6 rounded-xl border border-border bg-bg-elevated">
            <h3 class="text-xl font-semibold mb-3">{feature.title}</h3>
            <p class="text-text-secondary">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section-padding bg-bg-surface">
    <div class="container-custom">
      <SectionHeading
        title={copy.testimonials}
        subtitle={copy.testimonialsIntro}
        centered
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {testimonials.map((testimonial) => (
          <Testimonial {...testimonial} />
        ))}
      </div>
    </div>
  </section>
  <section class="section-padding">
    <div class="container-custom">
      <SectionHeading
        title={copy.modules}
        subtitle={copy.modulesIntro}
        centered
      />
      <div class="max-w-3xl mx-auto space-y-6">
        {product.curriculum.map((module, index) => (
          <div class="rounded-xl border border-border bg-bg-surface overflow-hidden">
            <h3 class="text-xl font-semibold p-5 border-b border-border flex items-center gap-3">
              <span class="flex items-center justify-center min-w-8 h-8 rounded-full bg-cream/5 text-cream text-sm">
                {index + 1}
              </span>
              {module.title}
            </h3>
            <ol class="p-5 space-y-3">
              {module.lessons.map((lesson, lessonIndex) => (
                <li class="flex items-start gap-3">
                  <span
                    class="shrink-0 w-6 h-6 rounded-full bg-bg-elevated flex items-center justify-center text-xs"
                    aria-hidden="true"
                  >
                    {lessonIndex + 1}
                  </span>
                  <span class="text-white/80">{lesson}</span>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </div>
  </section>
  <Faq items={courseFaq(product)} title={copy.questions} />
  <section class="section-padding bg-bg-surface">
    <div class="container-custom max-w-4xl">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">{copy.cta}</h2>
      <p class="text-white/80 text-lg mb-8">{copy.ctaIntro}</p>
      <CourseOffer product={product} />
      {!product.available && (
        <p class="text-text-secondary mt-4">{copy.closed}</p>
      )}
    </div>
  </section>
</Layout>
