---
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/astro/SectionHeading.astro";
import ProductGrid from "../../components/astro/ProductGrid.astro";
import Testimonial from "../../components/astro/Testimonial.astro";
import Faq from "../../components/astro/Faq.astro";
import { productData } from "../../data/product-data";
import { getRandomTestimonials } from "../../data/testimonial-data";
import { productsFaq } from "../../data/faq-data";
import { seoData } from "../../data/seo-data";
import { site } from "../../data/site.mjs";
import { catalogCopy as copy, ui } from "../../data/site-copy";
const testimonials = getRandomTestimonials(2);
const comparisonKeys = Object.keys(
  copy.comparisonLabels,
) as (keyof typeof copy.comparisonLabels)[];
---

<Layout
  title={seoData.products.title}
  description={seoData.products.description}
  keywords={seoData.products.keywords}
  canonical="/products/"
  jsonLd={seoData.products.jsonLd}
>
  <header class="container-custom pt-12 md:pt-16 pb-8">
    <h1 class="text-4xl md:text-5xl font-bold mb-5">{copy.title}</h1>
    <p class="text-lg text-text-secondary max-w-3xl">{copy.intro}</p>
  </header>
  <section id="products" class="py-8 md:py-12">
    <div class="container-custom">
      <SectionHeading title={copy.courses} subtitle={copy.coursesIntro} />
      <ProductGrid />
    </div>
  </section>
  <section class="section-padding bg-bg-surface">
    <div class="container-custom">
      <SectionHeading title={copy.compare} subtitle={copy.compareIntro} />
      <div class="overflow-x-auto">
        <table class="w-full max-w-4xl mx-auto border-collapse text-sm md:text-base">
          <caption class="sr-only">{copy.compare}</caption>
          <thead>
            <tr>
              <th scope="col" class="py-4 px-6 text-left">
                {copy.feature}
              </th>
              {productData.map((product) => (
                <th scope="col" class="py-4 px-6 text-center font-semibold">
                  {product.title}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            {comparisonKeys.map((key) => (
              <tr>
                <th scope="row" class="py-4 px-6 text-left font-normal">
                  {copy.comparisonLabels[key]}
                </th>
                {productData.map((product) => (
                  <td class="py-4 px-6 text-center text-white/80">
                    {product.comparison[key]}
                  </td>
                ))}
              </tr>
            ))}
            <tr>
              <th scope="row" class="py-4 px-6 text-left font-normal">
                {copy.price}
              </th>
              {productData.map((product) => (
                <td class="py-4 px-6 text-center font-semibold">
                  {product.price}
                </td>
              ))}
            </tr>
            <tr>
              <th scope="row" class="py-4 px-6 text-left font-normal">
                {copy.availability}
              </th>
              {productData.map((product) => (
                <td class="py-4 px-6 text-center">
                  <span class="rounded-full bg-cream/5 text-cream px-3 py-1 text-xs">
                    {product.available ? ui.available : ui.comingSoon}
                  </span>
                </td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="section-padding">
    <div class="container-custom">
      <SectionHeading
        title={copy.testimonials}
        subtitle={copy.testimonialsIntro}
        centered
      />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {testimonials.map((testimonial) => (
          <Testimonial {...testimonial} />
        ))}
      </div>
    </div>
  </section>
  <Faq items={productsFaq} title={copy.questions} />
  <section class="container-custom pb-16 text-center">
    <h2 class="text-2xl font-semibold mb-4">{copy.contactTitle}</h2>
    <p class="text-text-secondary mb-6">{copy.contactText}</p>
    <a href={`mailto:${site.email}`} class="site-button site-button-secondary">
      {copy.contact}
    </a>
  </section>
</Layout>
