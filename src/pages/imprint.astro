---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Informações legais | Dose de Telemetria"
	description="Informações legais e de contato da Dose de Telemetria GmbH, responsável pelos cursos de OpenTelemetry."
	canonical="/imprint"
>
	<div class="bg-telemetria-dark min-h-screen">
		<div class="container-custom py-16 md:py-24 animate-fade-in">
			<h1 class="text-3xl md:text-4xl font-bold mb-6">Informações legais</h1>
			<div class="w-full h-px bg-telemetria-yellow/30 mb-8"></div>

			<div class="bg-telemetria-darker border border-white/5 rounded-xl p-6 md:p-8 max-w-3xl">
				<h2 class="text-xl md:text-2xl font-semibold mb-6 text-telemetria-yellow">
					Informações legais
				</h2>

				<div class="space-y-8">
					<section>
						<h3 class="text-lg font-medium mb-3">Empresa</h3>
						<p class="text-white/80 mb-2">Dose de Telemetria GmbH</p>
					</section>

					<section>
						<h3 class="text-lg font-medium mb-3">Endereço</h3>
						<p class="text-white/80 mb-2">Hauptstr. 14</p>
						<p class="text-white/80 mb-2">13158 Berlin</p>
						<p class="text-white/80 mb-2">Alemanha</p>
					</section>

					<section>
						<h3 class="text-lg font-medium mb-3">Contato</h3>
						<p class="text-white/80 mb-2">E-mail: contact@dosedetelemetria.com</p>
						<p class="text-white/80 mb-2">Telefone: +49 176 4655-4626</p>
					</section>

					<section>
						<h3 class="text-lg font-medium mb-3">Responsável pelo conteúdo</h3>
						<p class="text-white/80 mb-2">Juraci Paixão Kröhling</p>
						<p class="text-white/80 mb-2">E-mail: juraci@dosedetelemetria.com</p>
					</section>

					<section>
						<h3 class="text-lg font-medium mb-3">Registro da empresa</h3>
						<p class="text-white/80 mb-2">Registrada sob o número HRB 269671 no registro comercial de Berlin-Charlottenburg</p>
						<p class="text-white/80 mb-2">Identificação de IVA: DE451875565</p>
					</section>
				</div>
			</div>
		</div>
	</div>
</Layout>
