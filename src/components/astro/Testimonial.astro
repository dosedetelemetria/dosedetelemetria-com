---
import { cn } from "../../lib/utils";

export interface Props {
  quote: string;
  author: string;
  role?: string;
  company?: string;
  avatarUrl?: string;
  className?: string;
}

const {
  quote,
  author,
  role,
  company,
  avatarUrl,
  className
} = Astro.props;

const initials = author
  .split(" ")
  .map((n) => n[0])
  .join("")
  .toUpperCase();

---


<div class={cn(
  "flex flex-col h-full rounded-lg border bg-card p-6 shadow-sm",
  className
)}>
  <div class="text-lg italic text-muted-foreground grow mb-6">
    "{quote}"
  </div>

  <div class="flex items-center space-x-4 mt-auto">
    <div class="h-12 w-12 border-2 border-telemetria-yellow/30 rounded-full overflow-hidden flex items-center justify-center bg-telemetria-yellow/20 text-telemetria-yellow shrink-0">
      {avatarUrl ? (
        <img width="48" height="48" loading="lazy" src={avatarUrl} alt={author} class="w-full h-full object-cover" />
      ) : (
        <span class="font-semibold text-sm">{initials}</span>
      )}
    </div>

    <div>
      <div class="font-semibold">{author}</div>
      {(role || company) && (
        <div class="text-sm text-muted-foreground">
          {role}
          {role && company && ", "}
          {company}
        </div>
      )}
    </div>
  </div>
</div>
