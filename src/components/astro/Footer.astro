---
import { site } from "../../data/site.mjs";
import { productData } from "../../data/product-data";
const currentYear = new Date().getFullYear();
---
<footer class="bg-telemetria-darker border-t border-white/5 pt-16 pb-8">
  <div class="container-custom">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-12">
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-2 mb-4">
          <img src="/logo.svg" alt={site.name} width="40" height="40" class="h-10 w-10" />
          <span class="font-bold text-xl tracking-tight">{site.name}</span>
        </a>
        <p class="text-sm text-muted-foreground max-w-xs">{site.footer.description}</p>
        <div class="flex space-x-4 pt-2">
          <a
            href={site.footer.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/70 hover:text-brand-link transition-colors"
            aria-label="YouTube"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/>
              <path d="m10 15 5-3-5-3z"/>
            </svg>
          </a>
          <a
            href={site.footer.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/70 hover:text-brand-link transition-colors"
            aria-label="LinkedIn"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect width="4" height="12" x="2" y="9"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
          <a
            href={`mailto:${site.email}`}
            class="text-white/70 hover:text-brand-link transition-colors"
            aria-label="Email"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-10 5L2 7"/>
            </svg>
          </a>
        </div>
      </div>
      <nav aria-label={site.footer.quickLinksTitle}>
        <h2 class="font-semibold text-white mb-4">{site.footer.quickLinksTitle}</h2>
        <ul class="space-y-2">
          {site.footer.links.map(link => <li><a href={link.href} class="text-white/70 hover:text-brand-link text-sm">{link.label}</a></li>)}
        </ul>
      </nav>
      <nav aria-label={site.footer.productsTitle}>
        <h2 class="font-semibold text-white mb-4">{site.footer.productsTitle}</h2>
        <ul class="space-y-2">
          {productData.map(product => <li><a href={`/products/${product.slug}/`} class="text-white/70 hover:text-brand-link text-sm">{product.title}</a></li>)}
        </ul>
      </nav>
    </div>
    <div class="border-t border-white/5 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-muted-foreground">&copy; {currentYear} Dose de Telemetria GmbH. {site.footer.rights}</p>
      <div class="flex flex-wrap justify-center gap-6">
        {site.footer.legal.map(link => <a href={link.href} class="text-sm text-white/70 hover:text-brand-link">{link.label}</a>)}
      </div>
    </div>
  </div>
</footer>
