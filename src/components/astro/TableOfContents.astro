---
import { ui } from "../../data/site-copy";
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Only show h2 and h3 headings
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{tocHeadings.length > 0 && (
  <nav data-table-of-contents aria-label={ui.toc} class="toc">
    <div class="text-xs font-semibold uppercase tracking-wider text-text-secondary mb-3">
      {ui.onThisPage}
    </div>
    <ul class="space-y-1 border-l border-white/10 text-sm">
      {tocHeadings.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            class:list={[
              "block border-l-2 -ml-px py-1 transition-colors hover:text-brand-link hover:border-telemetria-accent",
              heading.depth === 2 ? "pl-4 text-text-secondary border-transparent" : "pl-8 text-text-secondary border-transparent",
            ]}
            data-toc-link
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  function setupTocHighlighting() {
    const tocLinks = document.querySelectorAll('[data-toc-link]');
    if (tocLinks.length === 0 || tocLinks[0].hasAttribute("data-toc-initialized")) return;
    tocLinks.forEach(link => link.setAttribute("data-toc-initialized", ""));

    const headingIds = Array.from(tocLinks).map((link) => {
      const href = link.getAttribute('href');
      return href ? href.slice(1) : '';
    });

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            tocLinks.forEach((link) => {
              if (link.getAttribute('href') === `#${id}`) link.setAttribute('aria-current', 'location');
              else link.removeAttribute('aria-current');
            });
          }
        }
      },
      { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
    );

    headingIds.forEach((id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }

  document.addEventListener('DOMContentLoaded', setupTocHighlighting);
  document.addEventListener('astro:page-load', setupTocHighlighting);
</script>

<style>
  .toc a[aria-current="location"] { color: var(--color-brand-link); border-color: var(--color-brand-link); }
</style>
