---
import SEO from "../components/astro/SEO.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import { Toaster } from "../components/ui/sonner";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  keywords?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  twitterCard?: 'summary' | 'summary_large_image';
  jsonLd?: object;
}

const {
  title,
  description,
  canonical,
  keywords,
  ogImage,
  ogImageAlt,
  noindex,
  ogType,
  twitterCard,
  jsonLd
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      keywords={keywords}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
      twitterCard={twitterCard}
      jsonLd={jsonLd}
    />
  </head>
  <body class="bg-telemetria-darker text-white antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-telemetria-dark focus:p-3">Pular para o conteúdo</a>
    <div class="flex flex-col min-h-screen">
      <Navbar />
      <main id="main" class="grow pt-16">
        <slot />
      </main>
      <Footer />
    </div>
    <Toaster client:load />
  </body>
</html>
